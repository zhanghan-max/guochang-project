# Configure these only as server-side secret/runtime values; never put real keys in browser files.
# API generation remains off unless explicitly enabled by the owner.
ENABLE_PUBLIC_AI=false
API_SESSION_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
TTS_MODEL=qwen3-tts-flash
TTS_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
TTS_VOICE_ZH=Serena
TTS_VOICE_EN=Serena
TTS_VOICE_SC=Sunny
TTS_VOICE_YUE=Kiki

# Optional Doubao speech; use either the new API key or the legacy pair.
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_RESOURCE_ID=seed-tts-2.0
DOUBAO_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_SPEAKER_EN=zh_female_vv_uranus_bigtts

# Optional same-owner speech/chat backend during hosting migration.
API_RELAY_ORIGIN=
TRUST_PROXY=false
